{
  "name": "the-hollow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && node -e \"require('fs').rmSync('../web/hollow/static/hollow/index.html',{force:true})\"",
    "typecheck": "tsc --noEmit -p client",
    "server:dev": "tsx server/src/index.ts",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/dist/index.mjs --packages=external --alias:@shared=./shared",
    "sim:test": "tsx shared/test/sim.test.ts",
    "export-data": "tsx scripts/export-data.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/jacquard-12": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
